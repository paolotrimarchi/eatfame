# Copy this file to .env.local and fill in from your Supabase project
# (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> service_role key. SECRET -- server-only, only
# used by the Stripe webhook to update an order after payment. Never expose
# this to the browser (no NEXT_PUBLIC_ prefix, on purpose).
SUPABASE_SERVICE_ROLE_KEY=

# Where magic-link emails (and Stripe Checkout) should send people back to.
# Use http://localhost:3000 while developing, https://app.eatfame.com once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe -- both from dashboard.stripe.com, Developers -> API keys.
# Use the TEST mode keys (start with sk_test_) until you're ready to go live.
STRIPE_SECRET_KEY=
# From `stripe listen` (local dev) or the webhook you create in the Stripe
# dashboard (production) -- see apps/order/README.md for the exact steps.
STRIPE_WEBHOOK_SECRET=

# Resend -- sends the login-link email and the order-confirmation email, both
# with our own branded template instead of Supabase's default. Get the key
# from resend.com, Dashboard -> API Keys.
RESEND_API_KEY=
# Must be on a domain you've verified in Resend (Dashboard -> Domains) to send
# to real inboxes. Until eatfame.com is verified there, leave this as
# onboarding@resend.dev -- but that only delivers to your own Resend account
# email, so login/order emails to anyone else won't arrive.
EMAIL_FROM=Fame <onboarding@resend.dev>
